(rule
 (targets primitives prims.o libcamlrun.a libasmrun.a)
 (mode    fallback)
 (deps
   ../Makefile.config
   ../Makefile.build_config
   ../Makefile.config_if_required
   ../Makefile.common  ../Makefile
   ../compilerlibs/Makefile.compilerlibs
   ../stdlib/StdlibModules
   ../Makefile.menhir
   (glob_files caml/*.h)
   ; matches the line structure of files in Makefile/BYTECODE_C_SOURCES
   interp.c misc.c fix_code.c startup_aux.c startup_byt.c 
     major_gc.c
   minor_gc.c memory.c alloc.c globroots.c fail_byt.c signals.c
   printexc.c backtrace_byt.c backtrace.c compare.c ints.c
   floats.c str.c array.c io.c extern.c intern.c hash.c sys.c meta.c parsing.c
     gc_ctrl.c  md5.c obj.c
   lexing.c callback.c debugger.c weak.c finalise.c custom.c dynlink.c
   afl.c unix.c win32.c bigarray.c main.c memprof.c domain.c
   skiplist.c codefrag.c
   platform.c fiber.c sync.c prng.c sak.c addrmap.c gc_stats.c lf_skiplist.c roots.c shared_heap.c
   sync_posix.h
   backtrace_nat.c clambda_checks.c dynlink_nat.c fail_nat.c frame_descriptors.c startup_nat.c signals_nat.c
 )
 (action (chdir ../
   (progn
     (bash "touch config.status .depend .depend.menhir") ; hack.
     (run make %{targets} COMPUTE_DEPS=false -j8)
     (bash "rm config.status .depend .depend.menhir")))))

;; HACK
(library
  (name runtime)
  (wrapped false)
  (modules runtime)
  (flags (-nostdlib -nopervasives))
  (library_flags -cclib "-I runtime" -cclib "-lzstd")
  (self_build_stubs_archive (runtime)))

(rule
  (targets libruntime_stubs.a)
  (deps libcamlrun.a prims.o)
  (action (progn 
            (copy libcamlrun.a libcamlrun_.a)
            (run chmod +w libcamlrun_.a)
            (run ar r libcamlrun_.a prims.o)
            (copy libcamlrun_.a %{targets})
           )
          )
  )

(rule
  (targets runtime.ml)
  (action (write-file %{targets} "let linkme = ()")))
